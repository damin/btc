# 复制本文件并重命名为 .env 后按需修改

# 服务监听端口（本地默认 5050，云端平台会自动覆盖）
PORT=5050

# 后台自动拉取间隔（秒），默认 300 = 5 分钟
REFRESH_INTERVAL_SEC=300

# 启动模式：0=LIVE实盘接口，1=DEMO沙盘模式
USE_DEMO=0

# 永续合约数据源路由策略（美国本土均免代理直连）：
#   auto    = 默认直连 OKX 公开永续 (BTC-USDT-SWAP)，异常时自动无缝切 Deribit (BTC-PERPETUAL)
#   okx     = 强制仅用 OKX 公开永续
#   deribit = 强制仅用 Deribit 公开永续
EXCHANGE_SOURCE=auto

# 强烈推荐（免费 10,000 次/月，无需绑卡）：SoSoValue 官方现货 BTC ETF 净流入 API Key
# 免费申请地址: https://sosovalue.com/developer/console/keys
# 不填时系统会自动尝试零密钥解析 Farside Investors 官方表格
# SOSO_API_KEY=sk_live_WkoaYbzBATmygeysybg0x2cvj4HmYBaWiymV4WJeTWs

# 可选代理（美国本地直连无需代理）
# HTTPS_PROXY=http://127.0.0.1:7890
